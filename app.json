{
  "expo": {
    "name": "Automation",
    "slug": "mccashback",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mccashback",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/iosicon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.joshuabarua.mccashback",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to capture real-time video of rotating objects and apply visual effects by adjusting frame rate and exposure settings to create unique animations.",
        "NSMicrophoneUsageDescription": "This app may access the microphone if needed for video recording.",
        "NSPhotoLibraryAddUsageDescription": "Allow saving recorded videos to your Photos library.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Automation",
        "UIRequiresFullScreen": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ff5500"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.joshuabarua.mccashback",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-router",
      "react-native-vision-camera",
      "expo-media-library",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ff5500"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd150615-2e58-46b2-9939-a4384389f7c3"
      }
    }
  }
}
