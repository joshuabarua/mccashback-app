# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Allow reading specific dependencies for debugging
!node_modules/react-native-worklets-core/**
!node_modules/react-native-vision-camera/**
!node_modules/react-native-reanimated/**

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Native directories (generated by expo prebuild)
ios/
android/

# EAS Build
.easignore
build/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

keys/
*.json